# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Trained models / run artifacts (experiments/run_shd.py writes runs/<name>/model.npz)
models/
runs/
*.npz

# Datasets. SHD is auto-downloaded to a cache dir at runtime, never in-tree
# (dendroprop.data caches to ~/.cache/dendroprop or $DENDRO_CACHE_DIR).
*.h5
*.h5.gz

# Golden .npz fixtures are committed on purpose (the refactor's frozen safety
# net), overriding the *.npz rule above. Scoped to *.npz so it can't re-include
# __pycache__/ or other ignored cruft under tests/golden/.
!tests/golden/*.npz

# Environments
.venv/
venv/
env/
.conda/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Context
dendroprop_methods.pdf
